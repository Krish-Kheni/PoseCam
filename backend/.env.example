
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# Where session/file metadata is kept:
#   dynamodb (default)  needs DYNAMODB_TABLE. The only choice for a real (Lambda) deployment.
#   local               a SQLite file on this machine: NO DynamoDB needed. Local development only;
#                       the API refuses it on Lambda. Files still go to the real S3 bucket.
CATALOG_BACKEND=local
# LOCAL_CATALOG_PATH=local-catalog.db

# Only needed when CATALOG_BACKEND=dynamodb:
# DYNAMODB_TABLE=posecam-backend-SessionTable-ABCDEFGHIJKL

# ---- Behaviour ---------------------------------------------------------------------------------
# Temporary: there is no authentication yet. See the README "SECURITY" section.
AUTH_MODE=none

# Optional tuning (defaults shown).
# PRESIGNED_URL_TTL_SECONDS=900
# MULTIPART_THRESHOLD_BYTES=104857600     # 100 MiB: files at or above this use multipart upload
# MULTIPART_PART_SIZE_BYTES=16777216      # 16 MiB per part (S3 minimum is 5 MiB)
